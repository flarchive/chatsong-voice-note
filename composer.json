{
    "name": "chatsong/voice-note",
    "description": "Voice note recorder for Chatsong",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "extension"
    ],
    "license": "MIT",
    "require": {
        "flarum/core": "^1.8.0"
    },
    "autoload": {
        "psr-4": {
            "Chatsong\\VoiceNote\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Chatsong Voice Note",
            "icon": {
                "name": "fas fa-microphone",
                "backgroundColor": "#e11d48",
                "color": "#fff"
            }
        }
    }
}
